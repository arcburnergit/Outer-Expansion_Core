<event name="OE_ENEMY_BROADSIDE_EVENT">
	<preventFleet />
  <preventBossFleet />
	<preventQuest />
  <variable name="oe_broadside_roamer_killed" op="set" val="1"/>
  <text>You arrive at the beacon face to face with a strange rebel ship, it's unlike any design you've seen before. You don't have time to ponder as it turns it's weapons on you.</text>
  <ship load="OE_BROADSIDE_ENEMY" hostile="true"/>
  <choice hidden="true">
    <text>Continue...</text>
    <event load="COMBAT_CHECK"/>
  </choice>
</event>

<ship name="OE_BROADSIDE_ENEMY" auto_blueprint="OE_BROADSIDE_ENEMY">
	<destroyed load="DESTROYED_OE_BROADSIDE" />
	<deadCrew load="DEAD_CREW_OE_BROADSIDE" />
</ship>
<event name="DESTROYED_OE_BROADSIDE">
	<text>The fiery red of the explosions complements the orange hull of the Rebel ship. Satisfied with your handiwork, you scrap the ship.</text>
  <modifyPursuit amount="-2" />
  <unlockCustomShip silent="false">PLAYER_SHIP_OE_BROADSIDE</unlockCustomShip>
	<autoReward level="MED">standard</autoReward>
</event>
<event name="DEAD_CREW_OE_BROADSIDE">
	<text>With the Rebel vessel now clear of its crew, you are free to scrap the remains.</text>
  <modifyPursuit amount="-2" />
  <unlockCustomShip silent="false">PLAYER_SHIP_OE_BROADSIDE</unlockCustomShip>
  <!--unlockCustomShip silent="false">PLAYER_SHIP_OE_BROADSIDE</unlockCustomShip-->
	<autoReward level="HIGH">standard</autoReward>
</event>

<event name="OE_BROADSIDE3_MAIN">
  <text>Install the slot 1 weapon into one of the artillery systems, previously installed weapon will be lost.</text>
  <choice hidden="true">
    <text>Nevermind.</text>
    <event load="STORAGE_CHECK"/>
  </choice>
  <choice hidden="true" req="oe_broadside_c_has_weapon">
    <text>Install it into Artillery slot 1 (left most)</text>
    <event name="OE_BROADSIDE_C_SLOT1">
      <text>You install the weapon into the artillery system.</text>
    </event>
  </choice>
  <choice hidden="true" req="oe_broadside_c_has_weapon">
    <text>Install it into Artillery slot 2 (middle)</text>
    <event name="OE_BROADSIDE_C_SLOT2">
      <text>You install the weapon into the artillery system.</text>
    </event>
  </choice>
  <choice hidden="true" req="oe_broadside_c_has_weapon">
    <text>Install it into Artillery slot 3 (right most)</text>
    <event name="OE_BROADSIDE_C_SLOT3">
      <text>You install the weapon into the artillery system.</text>
    </event>
  </choice>
  <choice hidden="true" req="oe_broadside_c_has_weapon" lvl="0" max_lvl="0">
    <text>You need a weapon in your weapon system to install.</text>
    <event load="OPTION_INVALID"/>
  </choice>
</event>

</FTL>