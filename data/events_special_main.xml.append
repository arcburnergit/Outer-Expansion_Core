<?xml version="1.0" encoding="UTF-8"?>
<FTL>

<mod:findName type="event" name="START_BEACON_REAL" limit="1">
  <mod-append:queueEvent>OE_BROADSIDE_CHOOSE_ARTY</mod-append:queueEvent>
  <mod-append:queueEvent>OE_SET_TEST_VALUE</mod-append:queueEvent>
</mod:findName>

<event name="OE_SET_TEST_VALUE">
	<variable name="oe_test_variable" op="set" val="1"/>
</event>

<event name="OE_BROADSIDE_CHOOSE_ARTY">
  <loadEventList seeded="false" first="true" generate="false">
    <event req="SHIP_OE_BROADSIDE" lvl="1" max_lvl="99999">
      <text>Choose an artillery for slot 1</text>
      <choice hidden="false">
        <text>Laser Artillery.</text>
        <event>
          <text>.</text>
          <loadEvent>OE_BROADSIDE_CHOOSE_LASER_1</loadEvent>
          <weapon name="ARTILLERY_BROADSIDE_PIERCE"/>
        </event>
      </choice>
      <choice hidden="false">
        <text>Beam Artillery.</text>
        <event>
          <text>.</text>
          <loadEvent>OE_BROADSIDE_CHOOSE_BEAM_1</loadEvent>
          <weapon name="ARTILLERY_BROADSIDE_FOCUS"/>
        </event>
      </choice>
      <choice hidden="false" req="oe_broadside_missile_chosen" lvl="0" max_lvl="1" blue="false">
        <text>Missile Artillery (max: 2).</text>
        <event>
          <text>.</text>
          <loadEvent>OE_BROADSIDE_CHOOSE_MISSILE_1</loadEvent>
          <weapon name="ARTILLERY_BROADSIDE_MISSILE"/>
        </event>
      </choice>
      <choice hidden="false">
        <text>Ion Artillery.</text>
        <event>
          <text>.</text>
          <loadEvent>OE_BROADSIDE_CHOOSE_ION_1</loadEvent>
          <weapon name="ARTILLERY_BROADSIDE_MINE"/>
        </event>
      </choice>
    </event>
    <event req="SHIP_OE_BROADSIDE2" lvl="1" max_lvl="99999">
      <text>Choose an artillery for slot 1</text>
      <choice hidden="false">
        <text>Laser Artillery.</text>
        <event>
          <text>.</text>
          <loadEvent>OE_BROADSIDE2_CHOOSE_LASER_1</loadEvent>
          <weapon name="ARTILLERY_BROADSIDE2_LASER"/>
        </event>
      </choice>
      <choice hidden="false">
        <text>Beam Artillery.</text>
        <event>
          <text>.</text>
          <loadEvent>OE_BROADSIDE2_CHOOSE_BEAM_1</loadEvent>
          <weapon name="ARTILLERY_BROADSIDE2_BEAM"/>
        </event>
      </choice>
      <choice hidden="false" req="oe_broadside_missile_chosen" lvl="0" max_lvl="1" blue="false">
        <text>Missile Artillery (max: 2).</text>
        <event>
          <text>.</text>
          <loadEvent>OE_BROADSIDE2_CHOOSE_MISSILE_1</loadEvent>
          <weapon name="ARTILLERY_BROADSIDE2_MISSILE"/>
        </event>
      </choice>
      <choice hidden="false">
        <text>Ion Artillery.</text>
        <event>
          <text>.</text>
          <loadEvent>OE_BROADSIDE2_CHOOSE_ION_1</loadEvent>
          <weapon name="ARTILLERY_BROADSIDE2_ION"/>
        </event>
      </choice>
    </event>
    <event/>
  </loadEventList>
</event>

<event name="OE_BROADSIDE_CHOOSE_LASER_1">
  <text>You choose the laser.</text>
	<variable name="oe_broadside_slot1" op="set" val="1"/>
  <choice hidden="true">
    <text>Continue...</text>
    <event load="OE_BROADSIDE_CHOOSE_ARTY_2"/>
  </choice>
</event>
<event name="OE_BROADSIDE_CHOOSE_BEAM_1">
  <text>You choose the beam.</text>
	<variable name="oe_broadside_slot1" op="set" val="2"/>
  <choice hidden="true">
    <text>Continue...</text>
    <event load="OE_BROADSIDE_CHOOSE_ARTY_2"/>
  </choice>
</event>
<event name="OE_BROADSIDE_CHOOSE_MISSILE_1">
  <text>You choose the missile.</text>
	<variable name="oe_broadside_slot1" op="set" val="3"/>
	<variable name="oe_broadside_missile_chosen" op="add" val="1"/>
  <choice hidden="true">
    <text>Continue...</text>
    <event load="OE_BROADSIDE_CHOOSE_ARTY_2"/>
  </choice>
</event>
<event name="OE_BROADSIDE_CHOOSE_ION_1">
  <text>You choose the ion.</text>
	<variable name="oe_broadside_slot1" op="set" val="4"/>
  <choice hidden="true">
    <text>Continue...</text>
    <event load="OE_BROADSIDE_CHOOSE_ARTY_2"/>
  </choice>
</event>

