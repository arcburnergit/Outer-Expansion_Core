<mod:findLike type="achievements" limit="1" reverse="false">
	<mod-append:page>
		<section text="The Outer Cluster" hidden="false">
			<achievement name="ACH_OE_BROADSIDE_DEFEATED">
				<name>Volley of Abuse</name>
				<secretDescription>???</secretDescription>
				<description>Destroy the Rebel Broadsider in sector 7.</description>
				<icon>ach_oe_broadside_defeat</icon>
				<lockImage>ach_locked</lockImage>
				<multiDifficulty>true</multiDifficulty>
				<sound>achievement</sound>
			</achievement>
		</section>
		<section text="Unique Crew (OE)" hidden="false">
		</section>
		<section text="Loot Transports (OE)" hidden="false">
		</section>
		<section text="Renegade Cruisers (OE)" hidden="false">
		</section>
		<section text="Music (OE)" hidden="false">
		</section>
	</mod-append:page>
	<mod-append:page>
		<section text="Thest's Boons (OE)" hidden="false">
		</section>
	</mod-append:page>
</mod:findLike>
</FTL>